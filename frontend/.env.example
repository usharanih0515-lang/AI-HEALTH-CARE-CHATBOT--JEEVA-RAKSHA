# =============================================================================
# Jeeva Raksha — Frontend Environment Variables (.env.example)
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in real values.
#            This file is read by react-native-config.
#            Keys must be prefixed as shown below.
#            NEVER commit the real .env file to version control.
# =============================================================================

# ─────────────────────────────────────────────────────────────
# Backend API
# ─────────────────────────────────────────────────────────────
API_BASE_URL=http://10.0.2.2:5000/api/v1
# Note: On Android Emulator, use 10.0.2.2 to reach localhost on the host machine.
#       On a physical device, use your machine's local network IP (e.g., 192.168.1.x).
API_TIMEOUT=15000

# ─────────────────────────────────────────────────────────────
# Firebase Configuration
# Get these values from:
#   Firebase Console → Project Settings → General → Your Apps → Add App (Android/iOS)
# ─────────────────────────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:android:abcdef1234567890

# ─────────────────────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
DEFAULT_LANGUAGE=en
