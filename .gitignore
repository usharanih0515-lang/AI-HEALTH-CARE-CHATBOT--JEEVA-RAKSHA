# =============================================================================
# Jeeva Raksha — Root .gitignore
# =============================================================================

# ─── Environment Variables (NEVER commit these) ───────────────────────────────
**/.env
**/.env.local
**/.env.production
firebase-service-account.json
serviceAccountKey.json

# ─── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Backend Logs ─────────────────────────────────────────────────────────────
backend/logs/
*.log

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
venv/
.venv/
env/
.env/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ─── ML Model Files (large binary files — store in model registry, not Git) ───
ml-service/models/*.joblib
ml-service/models/*.pkl
ml-service/logs/

# ─── React Native ─────────────────────────────────────────────────────────────
frontend/.gradle
frontend/android/.gradle
frontend/android/app/debug/
frontend/android/app/release/
frontend/android/local.properties
frontend/ios/Pods/
frontend/ios/build/
frontend/*.jsbundle
frontend/.bundle/

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── Test Coverage ────────────────────────────────────────────────────────────
coverage/
.nyc_output/
