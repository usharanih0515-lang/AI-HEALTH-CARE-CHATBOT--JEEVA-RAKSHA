{
  "name": "jeeva-raksha-backend",
  "version": "1.0.0",
  "description": "Jeeva Raksha — Node.js + Express.js REST API backend server for the AI-Based Multilingual Smart Healthcare Application",
  "main": "server.js",
  "author": "Jeeva Raksha Dev Team",
  "license": "MIT",
  "private": true,

  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },

  "dependencies": {
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "mysql2": "^3.6.0",
    "firebase-admin": "^11.10.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.1",
    "uuid": "^9.0.0",
    "axios": "^1.5.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "express-rate-limit": "^6.10.0",
    "express-async-handler": "^1.2.0",
    "joi": "^17.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "i18next": "^23.4.6",
    "i18next-fs-backend": "^2.1.5",
    "nodemailer": "^6.9.5",
    "otp-generator": "^4.0.1"
  },

  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "supertest": "^6.3.3",
    "eslint": "^8.49.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jest": "^27.2.3"
  },

  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },

  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.js", "**/?(*.)+(spec|test).js"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.js", "!src/**/*.test.js"]
  }
}
